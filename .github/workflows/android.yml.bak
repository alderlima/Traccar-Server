name: Android CI

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v4  # Atualizado para v4
    
    - name: set up JDK 17
      uses: actions/setup-java@v4 # Atualizado para v4
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: gradle

    - name: Grant execute permission for gradlew
      run: chmod +x gradlew

    - name: Build ARM Debug APK
      run: ./gradlew :app:assembleDebug -Pandroid.injected.abi.list=armeabi-v7a,arm64-v8a

    - name: Upload APK
      uses: actions/upload-artifact@v4 # Atualizado para v4
      with:
        name: traccar-server-arm-debug
        path: app/build/outputs/apk/debug/*.apk
